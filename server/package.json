{
  "name": "davimf-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Node.js/TypeScript que substitui as Netlify Functions de davimf.dev",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server/src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@netlify/functions": "^5.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  }
}
