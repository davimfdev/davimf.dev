########################################################################
# davimf.dev — exemplo de variáveis de ambiente
#
# Copie para .env e preencha. NUNCA comite .env com valores reais.
#
#   cp .env.example .env
#
# REGRA DE OURO
#   Tudo que começa com VITE_ é embutido no bundle do frontend e fica
#   PÚBLICO para qualquer visitante do site. Segredo nenhum pode usar
#   esse prefixo. As demais variáveis são lidas só pelo backend
#   (server/) e nunca chegam ao browser.
########################################################################


# ======================================================================
# FRONTEND (Vite) — PÚBLICO. Cadastrar no recurso "davimf-site".
# ======================================================================

# Alvo do proxy /api do dev server do Vite. Só vale em desenvolvimento;
# não é embutido no bundle de produção.
# VITE_DEV_API_PROXY=http://localhost:3000


# ======================================================================
# BACKEND (server/) — SECRETO. Cadastrar no recurso "davimf-api".
# ======================================================================

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# URL pública do site. A Netlify preenchia `URL` automaticamente; fora
# dela é obrigatória. É usada para montar o completionUrl do checkout
# AbacatePay e a base dos links curtos.
URL=https://davimf.dev
# Apelido opcional: se `URL` não estiver definida, PUBLIC_SITE_URL é
# copiada para ela no boot.
# PUBLIC_SITE_URL=https://davimf.dev

# Limite do corpo das requisições (padrão: 5mb).
# BODY_LIMIT=5mb

# CORS: deixe VAZIO. Frontend e API compartilham o domínio davimf.dev,
# então não há requisição cross-origin. Preencha (lista separada por
# vírgula) apenas se algum cliente externo precisar chamar a API.
# CORS_ALLOWED_ORIGINS=

# ----------------------------------------------------------------------
# Bancos de dados (Neon) — são QUATRO bancos diferentes
# ----------------------------------------------------------------------

# Banco do site: tabelas urls, tasks, notes, accounts, transactions
# (fluxo autenticado por token do Discord).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Banco do site no namespace que a Netlify usava. Atende users,
# refresh_tokens, token_blacklist, expenses, transactions, transfer e as
# dashboard_sessions, além de ser o default do @netlify/neon (licenças
# FMM). Normalmente aponta para o MESMO banco de DATABASE_URL — confira
# no painel do Neon antes de assumir.
NETLIFY_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Banco de configuração do bot do Discord (guild_config, bot_guilds,
# snapshots, coleções do dashboard). Projeto Neon SEPARADO.
BOT_CONFIG_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Banco dos tickets criptografados.
TICKETS_NEON=postgresql://user:password@host/dbname?sslmode=require

# ----------------------------------------------------------------------
# Discord OAuth
# ----------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Precisa bater EXATAMENTE com uma das Redirects do Discord Developer
# Portal. Produção: https://davimf.dev/api/callback
DISCORD_REDIRECT_URI=https://davimf.dev/api/callback

# ----------------------------------------------------------------------
# Sessão do dashboard do bot
# ----------------------------------------------------------------------
# Mínimo de 32 bytes. Assina o cookie de sessão e o state do OAuth.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DASHBOARD_SESSION_SECRET=

# Exatamente 32 bytes em base64. Criptografa (AES-256-GCM) os tokens do
# Discord guardados no banco.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DASHBOARD_TOKEN_ENCRYPTION_KEY=

# IDs do Discord (17-20 dígitos) com acesso "support" a todas as guilds,
# separados por vírgula. OBRIGATÓRIA quando NODE_ENV=production.
BOT_SUPPORT_USER_IDS=

# ----------------------------------------------------------------------
# Auth JWT legada (expenses, transactions, transfer, refresh, logout)
# ----------------------------------------------------------------------
JWT_SECRET=

# ----------------------------------------------------------------------
# Licenças FMM
# ----------------------------------------------------------------------
# HMAC compartilhado com o app desktop (assina activate/validate).
FMM_APP_SECRET=
# Segredo administrativo do header x-admin-secret.
FMM_ADMIN_SECRET=

# ----------------------------------------------------------------------
# Pagamentos (AbacatePay) — não há Stripe neste projeto
# ----------------------------------------------------------------------
ABACATEPAY_KEY=
FMM_BASIC_MONTHLY_PRODUCT_ID=
FMM_BASIC_QUARTERLY_PRODUCT_ID=
FMM_BASIC_LIFETIME_PRODUCT_ID=
FMM_PRO_MONTHLY_PRODUCT_ID=
FMM_PRO_QUARTERLY_PRODUCT_ID=
FMM_PRO_LIFETIME_PRODUCT_ID=

# ----------------------------------------------------------------------
# Ingestão de tickets (header x-ticket-secret enviado pelo bot)
# ----------------------------------------------------------------------
TICKET_INGEST_SECRET=

# ----------------------------------------------------------------------
# Cotações de moeda (exchangerate-api.com)
# ----------------------------------------------------------------------
EXCHANGERATE_API_KEY=

# ----------------------------------------------------------------------
# Envio de e-mail — o código está comentado em
# netlify/functions/request-password-reset.ts. Só preencha ao reativar.
# ----------------------------------------------------------------------
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Pagamentos (módulo lib/payments) — Mercado Pago + Resend
# NUNCA comitar valores reais. Preencher no .env local e no painel do Coolify.
# ---------------------------------------------------------------------------
PAYMENTS_PROVIDER=mercadopago
PAYMENTS_ENV=sandbox
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
RESEND_API_KEY=

# Opcionais (têm padrão no código)
# MERCADOPAGO_TIMEOUT_MS=12000
# MERCADOPAGO_WEBHOOK_MAX_SKEW_MS=900000
# RESEND_TIMEOUT_MS=10000
# PAYMENTS_EMAIL_FROM=DAVIMF <noreply@davimf.dev>
# PAYMENTS_EMAIL_REPLY_TO=financeiro@davimf.dev
# PAYMENTS_EMAIL_SUPPORT=contato@davimf.dev
# Cópia recuperável da chave de licença (base64 de 32 bytes).
# Sem ela, cai em DASHBOARD_TOKEN_ENCRYPTION_KEY.
# PAYMENTS_LICENSE_ENCRYPTION_KEY=
# Sobrescreve o link de download do FMM (padrão: release oficial no GitHub).
# FMM_DOWNLOAD_URL=

# ---------------------------------------------------------------------------
# PostgreSQL (TCP, driver postgres.js — substituiu o driver HTTP da Neon)
#
# São bancos SEPARADOS; não unificar.
#   DATABASE_URL  -> davimf_dev  (site: todo, notas, encurtador, contas, auth,
#                                 FMM, pagamentos)
#   POSTGRES_URL  -> bot_configs (dashboard do bot)
#
# Os nomes herdados da Netlify continuam aceitos como alternativa:
#   NETLIFY_DATABASE_URL     (alternativa a DATABASE_URL)
#   BOT_CONFIG_DATABASE_URL  (alternativa a POSTGRES_URL)
#   TICKETS_DATABASE_URL     (alternativa a TICKETS_NEON)
# ---------------------------------------------------------------------------
POSTGRES_URL=postgres://usuario:senha@postgres:5432/bot_configs

# Ajustes do pool (todos opcionais, com padrão no código)
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT=30
# DB_CONNECT_TIMEOUT=10
# DB_MAX_LIFETIME=1800
# Desligue prepared statements atrás de PgBouncer em modo transaction:
# DB_PREPARE=false
# PGBOUNCER=true
# DB_LOG_NOTICES=true
